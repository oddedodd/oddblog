---
import { sanityClient } from 'sanity:client';
import '../styles/global.css';

type Post = {
	title: string;
	slug: { current: string };
	publishedAt: string;
	excerpt?: string;
};

const posts = await sanityClient.fetch<Post[]>(
	`*[_type == "post" && defined(slug.current)] | order(publishedAt desc) {
    title,
    slug,
    publishedAt,
    excerpt
  }`,
);
---

<html lang="en" class="antialiased">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>oddblog</title>
	</head>
	<body class="font-sans">
		<main class="overflow-hidden">
			<section class="relative isolate border-b border-stone-300 px-6 py-24 sm:px-10 sm:py-32 lg:px-16 lg:py-40">
				<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_80%_20%,rgba(190,242,100,0.5),transparent_30%),radial-gradient(circle_at_15%_85%,rgba(253,186,116,0.35),transparent_35%)]"></div>
				<div class="mx-auto max-w-6xl">
					<p class="mb-8 flex items-center gap-3 text-xs font-semibold tracking-[0.24em] text-stone-600 uppercase">
						<span class="h-px w-10 bg-stone-500"></span>
						Personal notes & selected work
					</p>
					<h1 class="max-w-5xl font-display text-6xl leading-[0.9] tracking-[-0.055em] text-stone-950 sm:text-8xl lg:text-[9rem]">
						Ideas, craft<br />& the web.
					</h1>
					<div class="mt-12 flex flex-col gap-8 border-t border-stone-400/70 pt-7 sm:flex-row sm:items-end sm:justify-between">
						<p class="max-w-xl text-lg leading-8 text-stone-700 sm:text-xl">
							A personal space for things I learn, things I make, and the details worth paying attention to.
						</p>
						<a
							href="#posts"
							class="group inline-flex w-fit items-center gap-3 text-sm font-semibold tracking-wide text-stone-950 uppercase"
						>
							Explore the writing
							<span class="grid size-10 place-items-center rounded-full border border-stone-500 transition group-hover:translate-y-1 group-hover:bg-stone-950 group-hover:text-white">↓</span>
						</a>
					</div>
				</div>
			</section>

			<section id="posts" class="px-6 py-20 sm:px-10 sm:py-28 lg:px-16">
				<div class="mx-auto max-w-6xl">
					<div class="mb-12 flex items-end justify-between border-b border-stone-300 pb-5">
						<div>
							<p class="mb-2 text-xs font-semibold tracking-[0.2em] text-stone-500 uppercase">From the notebook</p>
							<h2 class="font-display text-4xl tracking-tight text-stone-950 sm:text-5xl">Latest posts</h2>
						</div>
						<p class="hidden font-mono text-xs text-stone-500 sm:block">{String(posts.length).padStart(2, '0')} entries</p>
					</div>

					{posts.length === 0 ? (
						<div class="rounded-2xl border border-dashed border-stone-400 px-6 py-16 text-center">
							<p class="font-display text-2xl text-stone-800">The notebook is still empty.</p>
							<p class="mt-2 text-sm text-stone-500">
								Create the first post in the{' '}
								<a class="font-semibold underline decoration-lime-500 decoration-2 underline-offset-4" href="http://localhost:3333" target="_blank" rel="noreferrer">
									Sanity Studio
								</a>.
							</p>
						</div>
					) : (
						<ul class="divide-y divide-stone-300">
							{posts.map((post, index) => (
								<li>
									<a
										href={`/blog/${post.slug.current}/`}
										class="group grid gap-4 py-8 transition sm:grid-cols-[4rem_1fr_auto] sm:items-start sm:gap-6 sm:py-10"
									>
										<span class="font-mono text-xs text-stone-400">{String(index + 1).padStart(2, '0')}</span>
										<div>
											<h3 class="font-display text-3xl tracking-tight text-stone-900 transition group-hover:translate-x-2 sm:text-4xl">
												{post.title}
											</h3>
											{post.excerpt && <p class="mt-3 max-w-2xl leading-7 text-stone-600">{post.excerpt}</p>}
										</div>
										<div class="flex items-center gap-4 sm:justify-end">
											{post.publishedAt && (
												<time class="text-xs tracking-wide text-stone-500 uppercase" datetime={post.publishedAt}>
													{new Date(post.publishedAt).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })}
												</time>
											)}
											<span class="text-xl transition group-hover:translate-x-2">→</span>
										</div>
									</a>
								</li>
							))}
						</ul>
					)}
				</div>
			</section>
		</main>

		<footer class="border-t border-stone-300 px-6 py-8 sm:px-10 lg:px-16">
			<div class="mx-auto flex max-w-6xl items-center justify-between text-xs tracking-wide text-stone-500 uppercase">
				<span>oddblog</span>
				<span>Astro × Sanity</span>
			</div>
		</footer>
	</body>
</html>
